#include<iostream>
#include<stdio.h>
 using namespace std;
 struct node
 {
    int data;
    node*prev;
    node*next;
 };
    node*list=NULL;
void insert(int value)
{
    node*temp;
    temp=(node*) malloc(sizeof(node));
    temp->data=value;
    temp->next=NULL;
    temp->prev=NULL;
    if(list==NULL)
    {
        list=temp;
        return;
    }

    node*cur=list;
    while(cur->next!=NULL)
    {
        cur=cur->next;
        //cur->next=temp;
    }
   cur->next=temp;
   temp->prev=cur;
    }
 void display()
 {
    if(list==NULL)
    {
        cout<<"list is empty";
        return;
    }
    node*cur=list;
    while(cur!=NULL)
       { cout<<cur->data<<endl;
        cur=cur->next;}
 }
      

     void search(int value)
{
    if(list == NULL)
    {
        cout << "List is empty" << endl;
        return;
    }

    node* cur = list;
    int position = 1;

    while(cur != NULL)
    {
        if(cur->data == value)
        {
            cout << "Value found at position " << position << endl;
            return;
        }

        cur = cur->next;
        position++;
    }

    cout << "Value not found" << endl;
}
void reversedisplay()
{
    if(list == NULL)
    {
        cout << "List is empty\n";
        return;
    }

    node* cur = list;

    while(cur->next != NULL)
    {
        cur = cur->next;
    }

    while(cur != NULL)
    {
        cout << cur->data << " ";
        cur = cur->prev;
    }

    cout << endl;
}
void Delete(int value)
{
    if(list == NULL)
    {
        cout << "List is empty";
        return;
    }

    node* cur = list;

    while(cur != NULL)
    {
        if(cur->data == value)
        {
            // First node
            if(cur == list)
            {
                list = cur->next;

                if(list != NULL)
                    list->prev = NULL;
            }
            else
            {
                cur->prev->next = cur->next;

                if(cur->next != NULL)
                    cur->next->prev = cur->prev;
            }

            delete cur;
            cout << "Node deleted";
            return;
        }

        cur = cur->next;
    }

    cout << "Value not found";
}
